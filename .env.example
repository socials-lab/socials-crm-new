# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth (for Calendar integration)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# ===========================================
# Supabase Edge Function Secrets
# Set these in Supabase Dashboard > Project Settings > Edge Functions > Secrets
# ===========================================

# DigiSign API credentials (get from DigiSign Selfcare > Settings > For Developers > API Keys)
# DIGISIGN_ACCESS_KEY=your-access-key
# DIGISIGN_SECRET_KEY=your-secret-key
# DIGISIGN_WEBHOOK_SECRET=your-webhook-secret
# WEBHOOK_SECRET=your-shared-webhook-secret

# PDF Generator Service URL
# PDF_GENERATOR_URL=http://188.245.148.53:8094
